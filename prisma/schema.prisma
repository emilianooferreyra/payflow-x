generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(uuid())

  name        String?
  lastName    String?
  avatar      String?
  email       String  @unique
  backupEmail String?
  phone       String?
  password    String?
  country     String? @default("AR")
  language    String? @default("es-ES")

  emailConfirm       Boolean @default(false)
  backupEmailConfirm Boolean @default(false)
  phoneConfirm       Boolean @default(false)

  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?

  session     Session[]
  wallets     Wallet[]
  investments Investment[]
  cards         Card[]
  beneficiaries Beneficiary[]
  kyc           KycVerification?

  status       UserStatusEnum   @default(ACTIVE)
  authProvider AuthProviderEnum @default(LOCAL)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([createdAt])
}

model Session {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshToken         String
  refreshTokenVersion Int      @default(0)

  userAgent String?
  ipAddress String?
  location  String?

  isActive Boolean @default(true)

  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @updatedAt

  @@index([userId])
  @@index([userAgent])
  @@index([ipAddress])
}

enum UserStatusEnum {
  ACTIVE
  INACTIVE
  DRAFT
  BLOCKED
}

enum AuthProviderEnum {
  LOCAL
  GOOGLE
  FACEBOOK
  APPLE
}

model Wallet {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  currency CurrencyEnum
  balance  Decimal      @default(0) @db.Decimal(20, 8)
  version  Int          @default(1)

  transactions         Transaction[] @relation("WalletTransactions")
  incomingTransactions Transaction[] @relation("WalletIncomingTransactions")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, currency])
  @@index([userId])
}

model Transaction {
  id       String @id @default(uuid())
  walletId String
  wallet   Wallet  @relation("WalletTransactions", fields: [walletId], references: [id], onDelete: Cascade)

  toWalletId String?
  toWallet   Wallet? @relation("WalletIncomingTransactions", fields: [toWalletId], references: [id])

  type     TransactionTypeEnum
  amount   Decimal               @db.Decimal(20, 8)
  currency CurrencyEnum
  status   TransactionStatusEnum @default(PENDING)

  description String?
  category    TransactionCategoryEnum?
  metadata    Json?

  createdAt DateTime @default(now())

  @@index([walletId])
  @@index([toWalletId])
  @@index([createdAt])
  @@index([type])
  @@index([status])
}

model Asset {
  id     String        @id @default(uuid())
  symbol String        @unique
  name   String
  type   AssetTypeEnum

  currentPrice Decimal @db.Decimal(18, 2)
  dailyChange  Float   @default(0)
  logoUrl      String?

  investments Investment[]

  updatedAt DateTime @updatedAt

  @@index([symbol])
  @@index([type])
}

model Investment {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id])

  quantity     Decimal @db.Decimal(18, 8)
  avgBuyPrice  Decimal @db.Decimal(18, 2)
  currentValue Decimal @db.Decimal(18, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, assetId])
  @@index([userId])
  @@index([assetId])
}

model Card {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type          CardTypeEnum
  maskedNumber  String
  expiresAt     DateTime
  network       String?
  issuer        String?
  cardToken     String?
  isActive      Boolean  @default(true)
  isFrozen      Boolean  @default(false)
  spendingLimit Decimal? @db.Decimal(18, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model ExchangeRate {
  id           String       @id @default(uuid())
  fromCurrency CurrencyEnum
  toCurrency   CurrencyEnum
  rate         Decimal      @db.Decimal(18, 6)
  date         DateTime     @default(now())

  @@index([fromCurrency, toCurrency])
  @@index([date])
}

model KycVerification {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status       KycStatusEnum @default(PENDING)
  documentType String?
  submittedAt  DateTime?
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

enum CurrencyEnum {
  ARS
  USD
  USDT
  BRL
}

enum TransactionTypeEnum {
  DEPOSIT
  WITHDRAWAL
  TRANSFER
  EXCHANGE
  YIELD
  INVESTMENT_BUY
  INVESTMENT_SELL
}

enum TransactionStatusEnum {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum TransactionCategoryEnum {
  FOOD
  TRANSPORT
  ENTERTAINMENT
  HEALTH
  UTILITIES
  SHOPPING
  INVESTMENT
  TRANSFER
  OTHER
}

enum AssetTypeEnum {
  STOCK
  ETF
  COMMODITY
  CRYPTO
}

enum CardTypeEnum {
  INTERNATIONAL
  LOCAL
}

enum KycStatusEnum {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
}

model WebhookEndpoint {
  id        String   @id @default(uuid())
  url       String
  secret    String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries WebhookDelivery[]
}

model WebhookDelivery {
  id             String          @id @default(uuid())
  endpointId     String
  endpoint       WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  event          String
  payload        String
  status         String          @default("pending")
  attempts       Int             @default(0)
  responseStatus Int?
  nextRetryAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([endpointId, createdAt])
}

enum BeneficiaryTypeEnum {
  CBU
  CVU
  ALIAS
  SWIFT
  ACCOUNT_NUMBER
}

model Beneficiary {
  id              String               @id @default(uuid())
  userId          String
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  alias           String
  beneficiaryType BeneficiaryTypeEnum
  accountNumber   String
  bankName        String?
  currency        CurrencyEnum
  country         String               @default("AR")
  documentType    String?
  documentNumber  String?
  isActive        Boolean              @default(true)

  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([userId])
  @@index([userId, currency])
}

model IdempotencyRecord {
  id        String   @id @default(uuid())
  key       String   @unique
  userId    String
  route     String
  response  Json
  statusCode Int
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model UserBackupCode {
  id        String   @id @default(uuid())
  userId    String
  code      String
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@unique([userId, code])
  @@index([userId])
}

model AuditLog {
  id     String  @id @default(uuid())
  userId String?

  action   String
  entity   String
  entityId String

  metadata Json?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
}
